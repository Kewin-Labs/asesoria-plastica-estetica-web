# Chatwoot Environment Variables
SECRET_KEY_BASE=replace_with_generated_key
FRONTEND_URL=https://chat.asesoriaplasticayestetica.com
DEFAULT_LOCALE=es

# Database
POSTGRES_HOST=chatwoot-postgres
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=changeme_db_password
RAILS_ENV=production

# Redis
REDIS_URL=redis://chatwoot-redis:6379

# Email (SMTP)
MAILER_SENDER_EMAIL=noreply@asesoriaplasticayestetica.com
SMTP_DOMAIN=asesoriaplasticayestetica.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Storage
ACTIVE_STORAGE_SERVICE=local
